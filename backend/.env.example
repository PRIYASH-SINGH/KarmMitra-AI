# ─────────────────────────────────────────────────────────────────────────────
# KarmMitra AI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# USAGE: Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# INTENT: Separates secrets from source code. Never commit `.env` to git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database Connection ---
# For Docker Compose (container-to-container): use "db" as hostname
DATABASE_URL=postgresql+asyncpg://postgres:mospi_secure_password@db:5432/karmmitra_db
# For bare-metal local dev (no Docker): use "localhost"
# DATABASE_URL=postgresql+asyncpg://postgres:mospi_secure_password@localhost:5432/karmmitra_db

# --- Application Secret ---
SECRET_KEY=karmmitra-sih26101-dev-secret-change-in-prod

# --- CORS Origins (comma-separated) ---
# Member 4 Learner UI runs on :3000, Member 5 Admin UI on :5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# --- RAG Service (Member 2: Vedansh) ---
# CRITICAL (Blind Spot #3): Inside Docker, localhost means the container itself.
# Use host.docker.internal to reach services running on the host machine.
RAG_SERVICE_URL=http://host.docker.internal:11434
# For bare-metal local dev:
# RAG_SERVICE_URL=http://localhost:11434

# --- RAG Model Name (Ollama / vLLM) ---
RAG_MODEL_NAME=llama3:8b
