# Tool Host Configuration
TOOL_HOST=http://localhost:8000
TOOL_KEY_ID=karmmitra-tool-key-1

# iGOT Karmayogi Platform Configuration (LTI 1.3 Advantage)
PLATFORM_ISSUER=https://igot-karmayogi.gov.in
PLATFORM_CLIENT_ID=karmmitra-ai-client-id
PLATFORM_AUTH_URL=https://igot-karmayogi.gov.in/auth
PLATFORM_TOKEN_URL=https://igot-karmayogi.gov.in/oauth2/token
PLATFORM_KEYSET_URL=https://igot-karmayogi.gov.in/jwks.json

# Keys configuration (paths or file locations)
PRIVATE_KEY_PATH=certs/private.key
PUBLIC_KEY_PATH=certs/public.key

# Frontend Redirection URL
FRONTEND_URL=http://localhost:3000/competency-gap

# Bhashini DPI Translation Service (Live Two-Step Pipeline)
# Step 1 — Udyat modelConfigSearch: authenticated with BHASHINI_USER_ID + BHASHINI_UDYAT_KEY
# Step 2 — Dhruva Inference: authenticated with BHASHINI_INFERENCE_KEY (Authorization header)
BHASHINI_USER_ID=<YOUR_BHASHINI_USER_ID>
BHASHINI_UDYAT_KEY=<YOUR_BHASHINI_UDYAT_API_KEY>
BHASHINI_INFERENCE_KEY=<YOUR_BHASHINI_INFERENCE_API_KEY>
