# ─────────────────────────────────────────────────────────────────────────────
# KarmMitra AI — Root Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` at the repo root before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Member 1) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mospi_secure_password
POSTGRES_DB=karmmitra_db
DATABASE_URL=postgresql+asyncpg://postgres:mospi_secure_password@db:5432/karmmitra_db
SECRET_KEY=karmmitra-sih26101-dev-secret-change-in-prod

# --- RAG Service (Member 2) ---
RAG_SERVICE_URL=http://host.docker.internal:11434

# --- LTI Security (Member 3) ---
PLATFORM_ISSUER=https://igotkarmayogi.gov.in
PLATFORM_CLIENT_ID=karmmitra_sih26101_tool
PLATFORM_AUTH_URL=http://localhost:9000/platform/oidc/auth
PLATFORM_TOKEN_URL=http://mock-igot:9000/oauth2/token
PLATFORM_KEYSET_URL=http://mock-igot:9000/.well-known/jwks.json

# --- Mock iGOT (Member 6) ---
PORT=9000
TOOL_LAUNCH_URL=http://gateway:8000/lti/launch
